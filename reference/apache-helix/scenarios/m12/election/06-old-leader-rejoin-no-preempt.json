{
  "scenario_version": 2,
  "operation": "controller_election_failover_semantics",
  "kind": "election_focus",
  "name": "06-old-leader-rejoin-no-preempt",
  "description": "old leader rejoin",
  "cluster": {
    "state_model": "LeaderStandby",
    "controllers": [
      "controller-a",
      "controller-b",
      "controller-c"
    ],
    "participants": [],
    "resources": []
  },
  "steps": [
    {
      "op": "start_controllers",
      "controllers": [
        "controller-a",
        "controller-b",
        "controller-c"
      ]
    },
    {
      "op": "await_single_active_controller"
    },
    {
      "op": "kill_active_controller"
    },
    {
      "op": "await_single_active_controller"
    },
    {
      "op": "checkpoint",
      "name": "new_leader"
    },
    {
      "op": "restart_last_killed_controller"
    },
    {
      "op": "assert_restarted_controller_did_not_preempt"
    },
    {
      "op": "checkpoint",
      "name": "old_rejoined"
    }
  ],
  "expectations": {
    "settled_checkpoints": [
      "new_leader",
      "old_rejoined"
    ],
    "min_controller_failovers": 1,
    "require_stale_controller_fence": false,
    "require_session_replacement": false
  }
}
