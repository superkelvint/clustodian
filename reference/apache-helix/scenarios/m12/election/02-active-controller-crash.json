{
  "scenario_version": 2,
  "operation": "controller_election_failover_semantics",
  "kind": "election_focus",
  "name": "02-active-controller-crash",
  "description": "active process crashes and standby takes over",
  "cluster": {
    "state_model": "LeaderStandby",
    "controllers": [
      "controller-a",
      "controller-b",
      "controller-c"
    ],
    "participants": [],
    "resources": []
  },
  "steps": [
    {
      "op": "start_controllers",
      "controllers": [
        "controller-a",
        "controller-b",
        "controller-c"
      ]
    },
    {
      "op": "await_single_active_controller"
    },
    {
      "op": "checkpoint",
      "name": "before_crash"
    },
    {
      "op": "kill_active_controller"
    },
    {
      "op": "await_single_active_controller"
    },
    {
      "op": "checkpoint",
      "name": "after_failover"
    }
  ],
  "expectations": {
    "settled_checkpoints": [
      "before_crash",
      "after_failover"
    ],
    "min_controller_failovers": 1,
    "require_stale_controller_fence": false,
    "require_session_replacement": false
  }
}
