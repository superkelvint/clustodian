{
  "scenario_version": 2,
  "operation": "controller_election_failover_semantics",
  "kind": "election_focus",
  "name": "05-standby-restart-no-disruption",
  "description": "standby restart",
  "cluster": {
    "state_model": "LeaderStandby",
    "controllers": [
      "controller-a",
      "controller-b",
      "controller-c"
    ],
    "participants": [],
    "resources": []
  },
  "steps": [
    {
      "op": "start_controllers",
      "controllers": [
        "controller-a",
        "controller-b",
        "controller-c"
      ]
    },
    {
      "op": "await_single_active_controller"
    },
    {
      "op": "assert_active_controller_unchanged"
    },
    {
      "op": "checkpoint",
      "name": "before"
    },
    {
      "op": "restart_one_standby_controller"
    },
    {
      "op": "assert_active_controller_unchanged"
    },
    {
      "op": "checkpoint",
      "name": "after"
    }
  ],
  "expectations": {
    "settled_checkpoints": [
      "before",
      "after"
    ],
    "min_controller_failovers": 0,
    "require_stale_controller_fence": false,
    "require_session_replacement": false
  }
}
