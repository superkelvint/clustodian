{
  "scenario_version": 2,
  "operation": "controller_election_failover_semantics",
  "kind": "election_focus",
  "name": "08-controller-and-participant-fail-together",
  "description": "double failure",
  "cluster": {
    "state_model": "LeaderStandby",
    "controllers": [
      "controller-a",
      "controller-b",
      "controller-c"
    ],
    "participants": [
      {
        "id": "node-a",
        "zone": "z1",
        "session": "a1"
      },
      {
        "id": "node-b",
        "zone": "z2",
        "session": "b1"
      },
      {
        "id": "node-c",
        "zone": "z3",
        "session": "c1"
      }
    ],
    "resources": [
      {
        "name": "svc",
        "partitions": 4,
        "replicas": 2,
        "rebalance": "CRUSH"
      }
    ]
  },
  "steps": [
    {
      "op": "start_controllers",
      "controllers": [
        "controller-a",
        "controller-b",
        "controller-c"
      ]
    },
    {
      "op": "start_participants",
      "instances": [
        "node-a",
        "node-b",
        "node-c"
      ]
    },
    {
      "op": "create_resources"
    },
    {
      "op": "await_converged"
    },
    {
      "op": "checkpoint",
      "name": "initial"
    },
    {
      "op": "kill_active_controller_and_partition_leader",
      "resource": "svc",
      "partition": "svc_0"
    },
    {
      "op": "await_single_active_controller"
    },
    {
      "op": "await_converged"
    },
    {
      "op": "checkpoint",
      "name": "after_double_failure"
    }
  ],
  "expectations": {
    "settled_checkpoints": [
      "initial",
      "after_double_failure"
    ],
    "min_controller_failovers": 1,
    "require_stale_controller_fence": false,
    "require_session_replacement": false
  }
}
