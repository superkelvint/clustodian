{
  "scenario_version": 1,
  "operation": "participant_session_semantics",
  "instances": ["node-a"],
  "resources": [
    {"name": "documents", "partitions": ["documents_0"]},
    {"name": "vectors", "partitions": ["vectors_0", "vectors_1"]}
  ],
  "steps": [
    {"op": "connect", "instance": "node-a", "session": "a1"},
    {
      "op": "publish_current_state",
      "instance": "node-a",
      "session": "a1",
      "resource": "documents",
      "states": {"documents_0": "LEADER"}
    },
    {
      "op": "publish_current_state",
      "instance": "node-a",
      "session": "a1",
      "resource": "vectors",
      "states": {"vectors_0": "STANDBY", "vectors_1": "STANDBY"}
    },
    {"op": "checkpoint", "id": "old-session-two-resources"},
    {
      "op": "expire_and_reconnect",
      "instance": "node-a",
      "from_session": "a1",
      "to_session": "a2"
    },
    {"op": "checkpoint", "id": "new-session-empty"},
    {
      "op": "publish_current_state",
      "instance": "node-a",
      "session": "a2",
      "resource": "vectors",
      "states": {"vectors_0": "STANDBY"}
    },
    {"op": "checkpoint", "id": "new-session-one-resource"}
  ],
  "session_comparisons": [
    {"left": "a1", "right": "a2"}
  ]
}
