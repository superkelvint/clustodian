{
  "scenario_version": 1,
  "operation": "participant_session_semantics",
  "instances": ["node-a"],
  "resources": [
    {
      "name": "documents",
      "state_model": "LeaderStandby",
      "partitions": ["documents_0", "documents_1"]
    }
  ],
  "steps": [
    {"op": "connect", "instance": "node-a", "session": "a1"},
    {
      "op": "publish_current_state",
      "instance": "node-a",
      "session": "a1",
      "resource": "documents",
      "states": {
        "documents_0": "LEADER",
        "documents_1": "STANDBY"
      }
    },
    {"op": "checkpoint", "id": "old-session"},
    {"op": "disconnect", "instance": "node-a", "session": "a1"},
    {"op": "connect", "instance": "node-a", "session": "a2"},
    {"op": "checkpoint", "id": "replacement-session"}
  ],
  "session_comparisons": [
    {"left": "a1", "right": "a2"}
  ]
}
