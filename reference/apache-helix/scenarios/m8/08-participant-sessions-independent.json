{
  "scenario_version": 1,
  "operation": "participant_session_semantics",
  "instances": ["node-a", "node-b"],
  "resources": [
    {
      "name": "documents",
      "state_model": "LeaderStandby",
      "partitions": ["documents_0"]
    }
  ],
  "steps": [
    {"op": "connect", "instance": "node-a", "session": "a1"},
    {"op": "connect", "instance": "node-b", "session": "b1"},
    {
      "op": "publish_current_state",
      "instance": "node-a",
      "session": "a1",
      "resource": "documents",
      "states": {"documents_0": "LEADER"}
    },
    {
      "op": "publish_current_state",
      "instance": "node-b",
      "session": "b1",
      "resource": "documents",
      "states": {"documents_0": "STANDBY"}
    },
    {"op": "checkpoint", "id": "both-live"},
    {
      "op": "expire_and_reconnect",
      "instance": "node-a",
      "from_session": "a1",
      "to_session": "a2"
    },
    {"op": "checkpoint", "id": "a-replaced-b-unchanged"}
  ],
  "session_comparisons": [
    {"left": "a1", "right": "a2"},
    {"left": "a1", "right": "b1"},
    {"left": "a2", "right": "b1"}
  ]
}
