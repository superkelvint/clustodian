{
  "scenario_version": 1,
  "operation": "participant_session_semantics",
  "instances": ["node-a"],
  "resources": [
    {"name": "documents", "partitions": ["documents_0"]}
  ],
  "steps": [
    {"op": "connect", "instance": "node-a", "session": "a1"},
    {
      "op": "publish_current_state",
      "instance": "node-a",
      "session": "a1",
      "resource": "documents",
      "states": {"documents_0": "LEADER"}
    },
    {
      "op": "expire_and_reconnect",
      "instance": "node-a",
      "from_session": "a1",
      "to_session": "a2"
    },
    {
      "op": "inject_session_current_state",
      "instance": "node-a",
      "session": "a1",
      "resource": "documents",
      "states": {"documents_0": "LEADER"}
    },
    {"op": "checkpoint", "id": "after-expiry-before-new-state"},
    {
      "op": "publish_current_state",
      "instance": "node-a",
      "session": "a2",
      "resource": "documents",
      "states": {"documents_0": "STANDBY"}
    },
    {"op": "checkpoint", "id": "after-new-state"}
  ],
  "session_comparisons": [
    {"left": "a1", "right": "a2"}
  ]
}
