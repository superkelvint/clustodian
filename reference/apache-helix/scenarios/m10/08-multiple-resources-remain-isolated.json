{
  "scenario_version": 1,
  "operation": "controller_runtime_semantics",
  "instance_configs": [
    {"name":"node-a","zone":"zone-a"},
    {"name":"node-b","zone":"zone-b"}
  ],
  "setup": [
    {"op":"put_resource","resource":{"name":"documents","state_model":"LeaderStandby","placement":{"kind":"SEMI_AUTO","replicas":2,"preference_lists":{"documents_0":["node-a","node-b"]}}}},
    {"op":"put_resource","resource":{"name":"users","state_model":"LeaderStandby","placement":{"kind":"SEMI_AUTO","replicas":2,"preference_lists":{"users_0":["node-b","node-a"]}}}},
    {"op":"connect","instance":"node-a","session":"a1"},
    {"op":"connect","instance":"node-b","session":"b1"},
    {"op":"publish_current_state","instance":"node-a","session":"a1","resource":"documents","states":{"documents_0":"LEADER"}},
    {"op":"publish_current_state","instance":"node-b","session":"b1","resource":"documents","states":{"documents_0":"STANDBY"}},
    {"op":"publish_current_state","instance":"node-b","session":"b1","resource":"users","states":{"users_0":"LEADER"}},
    {"op":"publish_current_state","instance":"node-a","session":"a1","resource":"users","states":{"users_0":"STANDBY"}}
  ],
  "steps": [
    {"op":"checkpoint","id":"before-documents-change"},
    {"op":"publish_current_state","instance":"node-b","session":"b1","resource":"documents","states":{"documents_0":"OFFLINE"}},
    {"op":"checkpoint","id":"after-documents-change"}
  ]
}
